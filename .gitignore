# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js Build Outputs
/.next/
/out/
/build
/dist

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Environment Variables & Secrets
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Explicitly track env example templates
!.env.example
!.env.local.example

# Testing & Coverage
/coverage
*.lcov
.nyc_output

# Debug & Runtime Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Vercel & Turbo
.vercel
.turbo

# IDE & Editor Files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
